# npm's git-dependency policy (EALLOWGIT) and why `all`, not `root`:
#
#  - release.yml's `npm install -g npm@latest` delivers npm 12, whose default
#    allow-git=none kills `npm ci` on the specguard-ts git devDependency.
#  - The policy also exists in late npm 11 — node 25.9.0 bundles 11.12.1, and
#    that version misclassifies root-declared git deps under `npm ci`
#    ("Fetching non-root packages of type git..."), so the narrower `root`
#    fails the Node 25 CI leg while passing on npm 11.19.1 and 12.0.2
#    (verified locally, one-to-one with the runner).
#
# `all` is the per-project opt-in npm documents for exactly this: only
# installs of this repo read this file, and any transitive git dep still has
# to land in a reviewed package-lock.json diff. When Node 25 ships npm
# >= 11.19, consider tightening back to `root`.
allow-git=all
