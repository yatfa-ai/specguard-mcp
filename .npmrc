# npm 12 (what release.yml's `npm install -g npm@latest` delivers) blocks git
# dependencies by default — `npm ci` dies with EALLOWGIT on specguard-ts, which
# is pinned in package-lock.json as
# git+ssh://git@github.com/yatfa-ai/specguard-ts.git#e2cd5a4.
#
# `root` re-enables exactly our own case: git deps declared in the root
# package.json. Transitive git deps pulled in by third-party packages stay
# blocked, which is the point of the npm 12 default. npm < 12 warns about the
# unknown key and otherwise ignores it, so the CI matrix legs are unaffected.
allow-git=root
